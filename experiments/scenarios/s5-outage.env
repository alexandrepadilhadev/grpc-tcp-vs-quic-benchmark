# s5: 5 ms delay per side; server outage of OUTAGE_SECS at OUTAGE_AT s (spec §6.3)
# high rate 300 RPC/s: below 0.4 x C (C = 1000 RPC/s, payment spec §9), margin for VM noise
NETEM_DELAY=5
NETEM_JITTER=0
NETEM_LOSS=0
LOADGEN_ARGS="--rps=300 --concurrency=500 --duration=60s --warmup=10s"
OUTAGE_AT=30
OUTAGE_SECS=5
