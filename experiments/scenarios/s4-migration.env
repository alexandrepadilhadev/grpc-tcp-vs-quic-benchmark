# s4: client IP change at MIGRATE_AT, no delay, jitter or loss (TCC Tabela 2)
# high rate 300 RPC/s as s1/s3/s5 (payment spec §9); one migration per rep, ~20 s into the window
NETEM_DELAY=0
NETEM_JITTER=0
NETEM_LOSS=0
LOADGEN_ARGS="--rps=300 --concurrency=500 --duration=60s --warmup=10s --migrate-at=30s --migrate-to=10.10.0.250"
