# gRPC POC Configuration
# Copy this file to .env and adjust values as needed

# Transport mode: tcp or quic
APP_TRANSPORT=tcp

# Server configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=50051

# TLS certificate and key paths
TLS_CERT_PATH=./certs/localhost.pem
TLS_KEY_PATH=./certs/localhost_key.pem

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO

# Payment service configuration
PAYMENT_FAILURE_PROBABILITY=0.25